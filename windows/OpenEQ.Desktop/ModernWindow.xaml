<Window x:Class="OpenEQ.ModernWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenEQ" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="OpenDSP · Fa" Icon="Assets/opendsp.ico" Width="1440" Height="1000" MinWidth="1180" MinHeight="820" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#F4F6FA" FontFamily="Microsoft YaHei UI" Foreground="#202B43" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="82" ResizeBorderThickness="6" CornerRadius="14" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#586FF4"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#EDF1FB"/><Setter Property="Foreground" Value="#465575"/><Setter Property="Padding" Value="14,9"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.58"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Switch" TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Track" Width="40" Height="23" CornerRadius="12" Background="#D6DCE8" Margin="0,0,9,0"><Ellipse x:Name="Thumb" Width="17" Height="17" Fill="White" HorizontalAlignment="Left" Margin="3"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="#F5F7FC"/><Setter Property="Foreground" Value="#293650"/><Setter Property="BorderBrush" Value="#E5EAF4"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/><ToggleButton Focusable="False" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Grid></ControlTemplate></ToggleButton.Template><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#8592A9" StrokeThickness="1.5"/></ToggleButton><ContentPresenter x:Name="SelectionSite" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,9,30,9" IsHitTestVisible="False" VerticalAlignment="Center"/><TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Background="Transparent" BorderThickness="0" Padding="0" Margin="12,9,30,9" FontSize="12" IsReadOnly="{TemplateBinding IsReadOnly}" VerticalContentAlignment="Center"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="White" BorderBrush="#E1E7F2" BorderThickness="1" CornerRadius="10" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Padding="5"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEditable" Value="True"><Setter TargetName="SelectionSite" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#F5F7FC"/><Setter Property="BorderBrush" Value="#DFE6F2"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="14"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="18"/><Setter Property="BorderBrush" Value="#E8ECF5"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#8B97AE"/><Setter Property="FontSize" Value="11"/></Style>
  <Style x:Key="GroupTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#2B3957"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
  <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="HeaderDrag">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Width="42" Height="42" Background="{StaticResource Accent}" CornerRadius="13" Margin="0,0,13,0"><Viewbox Margin="10"><Path Data="M 0 14 L 0 22 M 6 5 L 6 31 M 12 0 L 12 36 M 18 10 L 18 26 M 24 5 L 24 31" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox></Border>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="OpenDSP" FontSize="25" FontWeight="Bold"/><TextBlock Text="开源 HiFi DSP 套件 · 精确塑造你的声音" FontSize="11" Foreground="#8793A9" Margin="0,1,0,0"/></StackPanel>
   </StackPanel>
   <StackPanel x:Name="HeaderActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Click="SettingsClick" Content="设置" Background="Transparent" Foreground="#96A2B7" Padding="8"/><Button Click="AboutClick" Content="关于" Background="Transparent" Foreground="#96A2B7" Padding="8"/>
    <Border Width="1" Height="26" Background="#E1E6F0" Margin="18,0"/><Button Content="—" Background="Transparent" Click="MinimizeClick" Padding="12,9"/><Button Content="□" Background="Transparent" Click="MaximizeClick" Padding="12,9"/><Button Content="×" Background="Transparent" Click="CloseClick" FontSize="19" Padding="12,5"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="28,0,28,14" Padding="22,16">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel>
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
      <CheckBox x:Name="Exclusive" ToolTip="USB 独占输出：全应用音频经独占链路直出 USB 声卡。可与原生系统 EQ 同时开启" ToolTipService.ShowOnDisabled="True" Style="{StaticResource Switch}" IsChecked="True" Content="USB 独占输出" FontSize="16" FontWeight="SemiBold"/>
      <CheckBox x:Name="NativeMode" Style="{StaticResource Switch}" Content="原生系统 EQ" Margin="18,0,0,0" FontSize="16" FontWeight="SemiBold" ToolTip="共享模式：EQ 由 Windows 音频引擎（audiodg）原生浮点处理。USB 独占模式：EQ 由 DSP 机架执行（64-bit 双精度、同率零转换）。两开关互不排斥，可同时开启"/>
      <Border x:Name="StateBadge" Background="#F0F3F9" CornerRadius="6" Margin="14,0,0,0" Padding="10,4"><TextBlock x:Name="StateTitle" Text="待机" FontSize="11" Foreground="#8390A6" VerticalAlignment="Center"/></Border>
     </StackPanel>
     <Button x:Name="NativeFormatButton" DockPanel.Dock="Right" Content="同步到系统" Click="NativeFormatClick" Padding="9,4" Margin="10,0,0,0"/>
     <TextBlock x:Name="DeviceStatus" Text="设备自动检测已开启" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#8793A9"/>
    </DockPanel>
    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="130"/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/><ColumnDefinition Width="16"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="系统音频入口" Style="{StaticResource Caption}" Margin="1,0,0,7"/><ComboBox x:Name="InputDevices" SelectionChanged="DeviceSelected" DisplayMemberPath="Name" ToolTip="中转入口：所有应用的声音汇入这里"/></StackPanel>
     <TextBlock Grid.Column="1" Text="→" Foreground="#A5B1C6" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,9"/>
     <StackPanel Grid.Column="2"><TextBlock Text="USB 声卡 / 输出设备" Style="{StaticResource Caption}" Margin="1,0,0,7"/><ComboBox x:Name="OutputDevices" SelectionChanged="DeviceSelected" DisplayMemberPath="Name"/></StackPanel>
     <StackPanel Grid.Column="4"><TextBlock Text="采样率" Style="{StaticResource Caption}" Margin="1,0,0,7"/><ComboBox x:Name="SampleRate" IsEditable="True" IsTextSearchEnabled="False"/></StackPanel>
     <StackPanel Grid.Column="6"><TextBlock Text="位深" Style="{StaticResource Caption}" Margin="1,0,0,7"/><ComboBox x:Name="BitDepth"/></StackPanel>
     <Button x:Name="StartButton" Grid.Column="8" Content="▶  开始处理" Style="{StaticResource Primary}" VerticalAlignment="Bottom" Height="42" Click="StartStopClick"/>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
      <CheckBox x:Name="RouteDefault" Content="接管系统默认输出，停止时恢复" IsChecked="True" FontSize="11" Foreground="#7D8AA2" VerticalAlignment="Center"/>
      <RadioButton x:Name="RateFollow" GroupName="ratePolicy" Content="跟随入口 · 输出采用入口采样率" Margin="20,0,0,0" FontSize="11" Foreground="#4B7A55" Checked="RatePolicyChanged" IsChecked="True"/>
      <RadioButton x:Name="RateMax" GroupName="ratePolicy" Content="固定目标 · 使用所选采样率（异率时转换）" Margin="14,0,0,0" FontSize="11" Foreground="#7A5B4B" Checked="RatePolicyChanged"/>
     </StackPanel>
     <TextBlock x:Name="RouteStatus" MaxWidth="520" TextTrimming="CharacterEllipsis" Text="选择设备后开始，声音将在此统一处理" FontSize="11" Foreground="#8B97AE" HorizontalAlignment="Right"/>
    </DockPanel>
   </Grid>
  </Border>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="28,0,28,18">
    <Border Style="{StaticResource Card}" Padding="26,20">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="340"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel>
       <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock Text="参数均衡器" Style="{StaticResource GroupTitle}"/><TextBlock x:Name="BandCount" Text="7 / 32 段" Foreground="#8D99AF" Margin="12,4,0,0" FontSize="11"/></StackPanel>
       <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <ComboBox x:Name="PresetPick" Width="230" SelectionChanged="PresetPickChanged" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="预设：内置风格与已保存预设"/>
        <Button x:Name="PresetButton" Content="预设管理 ▾" Click="PresetClick" Padding="8,6" Margin="0,0,10,0" ToolTip="预设选项：保存 / 重命名 / 自动记忆" VerticalAlignment="Center"/>
        <Button Content="31 段图示 EQ" Click="Graphic31Click" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="前级 dB" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Caption}"/><local:NumberEditor x:Name="Preamp" Width="110" Minimum="-60" Maximum="0" Decimals="1" Value="-6" VerticalAlignment="Center"/>
        <CheckBox x:Name="EqEnabled" Style="{StaticResource Switch}" Content="启用 EQ" IsChecked="True" Margin="18,0,0,0" Checked="EqToggle" Unchecked="EqToggle" FontSize="11"/>
       </StackPanel>
      </DockPanel>
      <local:EqGraph x:Name="Graph" Grid.Row="1" Margin="0,12,0,6"/>
      <Grid Grid.Row="2">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
       <ListBox x:Name="Bands" BorderThickness="0" Background="Transparent" SelectionChanged="BandSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Height="72">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,9,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" Background="#F3F6FC" CornerRadius="10" BorderThickness="1" BorderBrush="Transparent" Padding="12,8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="#EBEFFF"/><Setter TargetName="Tile" Property="BorderBrush" Value="#8F9FFA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Caption}" FontSize="10" Foreground="#8793A9"/><TextBlock Text="{Binding Frequency}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <Button Grid.Column="1" Content="＋" FontSize="22" Padding="0" Width="42" Height="60" VerticalAlignment="Top" Click="AddBandClick" ToolTip="添加滤波器"/>
      </Grid>
      <Border Grid.Row="3" Background="#F7F9FD" CornerRadius="12" Padding="14,10" Margin="0,8,0,0">
       <StackPanel Orientation="Horizontal">
        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock x:Name="SelectedTitle" Text="频段 01" FontWeight="SemiBold"/><CheckBox x:Name="BandEnabled" Style="{StaticResource Switch}" IsChecked="True" Checked="BandToggle" Unchecked="BandToggle" Content="启用" FontSize="10"/></StackPanel>
        <StackPanel Margin="0,0,10,0"><TextBlock Text="滤波类型" Style="{StaticResource Caption}"/><ComboBox x:Name="FilterType" SelectionChanged="FilterChanged" Width="120"/></StackPanel>
        <StackPanel Margin="0,0,10,0"><TextBlock Text="频率 Hz" Style="{StaticResource Caption}"/><local:NumberEditor x:Name="Frequency" Width="132" Minimum="20" Maximum="20000" Value="1000" Decimals="1"/></StackPanel>
        <StackPanel Margin="0,0,10,0"><TextBlock Text="增益 dB" Style="{StaticResource Caption}"/><local:NumberEditor x:Name="Gain" Width="132" Minimum="-24" Maximum="24" Decimals="1"/></StackPanel>
        <StackPanel Margin="0,0,10,0"><TextBlock Text="Q 值" Style="{StaticResource Caption}"/><local:NumberEditor x:Name="Quality" Width="132" Minimum="0.1" Maximum="30" Value="0.707" Decimals="3"/></StackPanel>
        <StackPanel Margin="0,0,14,0"><TextBlock Text="作用声道" Style="{StaticResource Caption}"/><ComboBox x:Name="Channel" SelectionChanged="FilterChanged" Width="100"/></StackPanel>
        <StackPanel VerticalAlignment="Center"><Button x:Name="CopyBandButton" Content="复制" Click="DuplicateClick" Margin="0,0,6,6"/><Button x:Name="DeleteBandButton" Content="删除" Click="DeleteBandClick" Foreground="#A17D89"/></StackPanel>
        <TextBlock x:Name="BandHint" Text="曲线节点=频段：最多 32 段，双击曲线任意处新增，节点贴合总曲线；滚轮调 Q，实时生效。" Foreground="#9AA5B9" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="140" Margin="12,0,0,0"/>
       </StackPanel>
      </Border>
     </Grid>
    </Border>
    <Border Style="{StaticResource Card}" Padding="26,20" Margin="0,16,0,0">
     <StackPanel>
      <DockPanel>
       <WrapPanel DockPanel.Dock="Right"><CheckBox x:Name="SpatialEnabled" Content="启用空间处理" Click="SpatialEnableClick" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="旁路" Click="SpatialBypassClick" Margin="0,0,8,0"/><Button Content="恢复默认" Tag="spatial" Click="ResetRackClick"/></WrapPanel>
       <TextBlock Text="高级 EQ / 声场" Style="{StaticResource GroupTitle}" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Text="M/S分别控制中央与侧向信息；主EQ仍支持左右独立。高级空间块用于USB独占/中转DSP（PCM及DSD编码前），现有原生APO不支持。" TextWrapping="Wrap" Foreground="#7D8AA2" FontSize="11" Margin="0,10,0,10"/>
      <WrapPanel><ComboBox x:Name="SpatialScenePick" Width="200" DisplayMemberPath="Name"/><Button Content="应用试听场景" Click="SpatialSceneClick" Margin="8,0,8,0"/><Button Content="编辑中央 / 侧向 EQ…" Click="MidSideEditorClick" Margin="0,0,8,0"/><TextBlock x:Name="SpatialBankStatus" VerticalAlignment="Center" Foreground="#7D8AA2"/></WrapPanel>
      <Expander Header="展开高级参数" Margin="0,14,0,0">
       <StackPanel>
        <WrapPanel Margin="0,10,0,8">
         <StackPanel Width="145" Margin="0,0,12,0"><TextBlock Text="效果混合 %"/><local:NumberEditor x:Name="SpatialMix" Minimum="0" Maximum="100" Decimals="1"/></StackPanel>
         <StackPanel Width="145" Margin="0,0,12,0"><TextBlock Text="中央增益 dB"/><local:NumberEditor x:Name="SpatialMidGain" Minimum="-12" Maximum="6" Decimals="1"/></StackPanel>
         <StackPanel Width="145" Margin="0,0,12,0"><TextBlock Text="侧向增益 dB"/><local:NumberEditor x:Name="SpatialSideGain" Minimum="-18" Maximum="6" Decimals="1"/></StackPanel>
         <CheckBox x:Name="SpatialMono" Content="单声道混合" Click="SpatialMonoClick" VerticalAlignment="Center" ToolTip="100%效果混合时为单声道；降低混合可与原声比较。"/>
        </WrapPanel>
        <WrapPanel Margin="0,0,0,8">
         <StackPanel Width="145" Margin="0,0,12,0"><TextBlock Text="低频宽度 %"/><local:NumberEditor x:Name="SpatialLowWidth" Minimum="0" Maximum="200" Decimals="1"/></StackPanel>
         <StackPanel Width="145" Margin="0,0,12,0"><TextBlock Text="中频宽度 %"/><local:NumberEditor x:Name="SpatialMidWidth" Minimum="0" Maximum="200" Decimals="1"/></StackPanel>
         <StackPanel Width="145" Margin="0,0,12,0"><TextBlock Text="高频宽度 %"/><local:NumberEditor x:Name="SpatialHighWidth" Minimum="0" Maximum="200" Decimals="1"/></StackPanel>
         <StackPanel Width="145" Margin="0,0,12,0"><TextBlock Text="低分频点 Hz"/><local:NumberEditor x:Name="SpatialLowCross" Minimum="50" Maximum="1000" Decimals="0"/></StackPanel>
         <StackPanel Width="145" Margin="0,0,12,0"><TextBlock Text="高分频点 Hz"/><local:NumberEditor x:Name="SpatialHighCross" Minimum="500" Maximum="10000" Decimals="0"/></StackPanel>
        </WrapPanel>
        <WrapPanel>
         <StackPanel Width="145" Margin="0,0,12,0"><TextBlock Text="交叉馈送 %"/><local:NumberEditor x:Name="SpatialCrossfeed" Minimum="0" Maximum="45" Decimals="1"/></StackPanel>
         <StackPanel Width="145" Margin="0,0,12,0"><TextBlock Text="馈送低通 Hz"/><local:NumberEditor x:Name="SpatialCrossfeedHz" Minimum="100" Maximum="1500" Decimals="0"/></StackPanel>
         <StackPanel Width="145" Margin="0,0,12,0"><TextBlock Text="馈送延时 ms"/><local:NumberEditor x:Name="SpatialCrossfeedDelay" Minimum="0" Maximum="0.8" Decimals="2"/></StackPanel>
        </WrapPanel>
        <TextBlock Text="宽度100%为原比例；分区为平滑过渡。交叉馈送保持中央单声道，主要改变两侧分离。主EQ图不包含空间块；完整声道频响、相位和群延迟可在设置中导出。" TextWrapping="Wrap" Foreground="#8B97AE" FontSize="11" Margin="0,12,0,0"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Padding="26,20" Margin="0,16,0,0">
     <StackPanel>
      <DockPanel>
       <TextBlock Text="目标曲线 / AI 调音" Style="{StaticResource GroupTitle}" DockPanel.Dock="Left"/>
       <WrapPanel HorizontalAlignment="Right"><Button Content="导入耳机频响 CSV" Click="TuneImportClick" Margin="0,0,8,0"/><Button Content="导入目标 CSV" Click="TargetImportClick" Margin="0,0,8,0"/><Button Content="清除测量/叠加" Click="TuneClearClick"/></WrapPanel>
      </DockPanel>
      <TextBlock x:Name="MeasurementStatus" Text="点击卡片先预览。声学目标需要同测量体系的耳机原始频响；听感偏好是相对EQ形状。" Foreground="#7D8AA2" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,8"/>
      <WrapPanel>
       <TextBlock Text="测量体系" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <ComboBox x:Name="MeasurementRig" Width="160" SelectedIndex="0" SelectionChanged="CurveRigChanged" Margin="0,0,16,0">
        <ComboBoxItem Content="请选择测量体系" Tag="none"/><ComboBoxItem Content="711 / 入耳" Tag="711"/><ComboBoxItem Content="GRAS / 头戴" Tag="GRAS"/><ComboBoxItem Content="GRAS KEMAR" Tag="GRAS-KEMAR"/><ComboBoxItem Content="B&amp;K 5128" Tag="5128"/><ComboBoxItem Content="ISO 11904-1" Tag="ISO11904-1"/><ComboBoxItem Content="自定义同一体系" Tag="custom"/>
       </ComboBox>
       <TextBlock Text="最多段数" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <ComboBox x:Name="FitBands" Width="80" SelectedIndex="3" Margin="0,0,16,0"><ComboBoxItem Content="8"/><ComboBoxItem Content="12"/><ComboBoxItem Content="16"/><ComboBoxItem Content="20"/><ComboBoxItem Content="24"/><ComboBoxItem Content="32"/></ComboBox>
       <TextBlock Text="拟合上限 Hz" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <ComboBox x:Name="FitMaxHz" Width="110" SelectedIndex="0" ToolTip="默认8kHz；更高频更受佩戴和测量条件影响，可按数据质量提高上限。"><ComboBoxItem Content="8000"/><ComboBoxItem Content="10000"/><ComboBoxItem Content="12000"/><ComboBoxItem Content="16000"/><ComboBoxItem Content="20000"/></ComboBox>
      </WrapPanel>
      <WrapPanel Margin="0,10,0,0">
       <ComboBox x:Name="CurveCategory" Width="150" SelectedIndex="0" SelectionChanged="CurveFilterChanged" Margin="0,0,10,0"><ComboBoxItem Content="全部曲线"/><ComboBoxItem Content="声学目标"/><ComboBoxItem Content="听感偏好"/></ComboBox>
       <TextBox x:Name="CurveSearch" Width="300" TextChanged="CurveSearchChanged" ToolTip="搜索名称、测量体系或描述"/>
      </WrapPanel>
      <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="CurveList" Margin="0,14,0,0"/></ScrollViewer>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Padding="26,20" Margin="0,16,0,0">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel>
       <DockPanel Margin="0,0,0,10"><Button Content="恢复默认" Tag="output" Click="ResetRackClick" DockPanel.Dock="Right" ToolTip="恢复输出增益、平衡、延时、反相和峰值保护；保留EQ、压缩器和矩阵。"/><TextBlock Text="输出级" Style="{StaticResource GroupTitle}" VerticalAlignment="Center"/></DockPanel>
       <WrapPanel ItemWidth="118" ItemHeight="132">
        <local:Knob x:Name="OutGain" Caption="输出增益" Unit="dB" Minimum="-60" Maximum="0" Value="0" Decimals="1"/>
        <local:Knob x:Name="OutBalance" Caption="平衡 −1…+1" Minimum="-1" Maximum="1" Value="0" Decimals="2"/>
        <local:Knob x:Name="OutDelayL" Caption="左延时" Unit="ms" Minimum="0" Maximum="100" Value="0" Decimals="1"/>
        <local:Knob x:Name="OutDelayR" Caption="右延时" Unit="ms" Minimum="0" Maximum="100" Value="0" Decimals="1"/>
        <local:Knob x:Name="OutCeiling" Caption="峰值上限" Unit="dBFS" Minimum="-12" Maximum="0" Value="-1" Decimals="1"/>
       </WrapPanel>
       <WrapPanel Margin="0,6,0,0"><CheckBox x:Name="ChkInvL" Content="左反相" Margin="0,0,16,0"/><CheckBox x:Name="ChkInvR" Content="右反相" Margin="0,0,16,0"/><CheckBox x:Name="ChkProtect" Content="峰值保护" IsChecked="True"/></WrapPanel>
       <TextBlock Text="sample-peak 保护，不是 true-peak 限幅器" Foreground="#9BA7BB" FontSize="9" Margin="0,6,0,0"/>
       <Button Content="全部输出处理恢复默认" Tag="all" Click="ResetRackClick" Margin="0,12,0,0" ToolTip="恢复输出级、压缩器、矩阵及直流滤波；保留EQ、前级、采样率和DSD模式。可撤销。"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
       <DockPanel Margin="0,0,0,10"><Button Content="恢复默认" Tag="compressor" Click="ResetRackClick" DockPanel.Dock="Right"/><TextBlock Text="动态处理 · 压缩器" Style="{StaticResource GroupTitle}" VerticalAlignment="Center"/></DockPanel>
       <CheckBox x:Name="CompOn" Content="启用压缩器（立体声联动）" Margin="0,0,0,8"/>
       <local:VuMeter x:Name="GrMeter" Caption="增益衰减 GR" Width="250" Height="28"/>
       <WrapPanel ItemWidth="118" ItemHeight="132" Margin="0,8,0,0">
        <local:Knob x:Name="CompThr" Caption="阈值" Unit="dB" Minimum="-60" Maximum="0" Value="-18" Decimals="1"/>
        <local:Knob x:Name="CompRatio" Caption="压缩比" Minimum="1" Maximum="20" Value="4" Decimals="1"/>
        <local:Knob x:Name="CompAtk" Caption="启动" Unit="ms" Minimum="0.1" Maximum="200" Value="10" Decimals="1"/>
        <local:Knob x:Name="CompRel" Caption="释放" Unit="ms" Minimum="5" Maximum="2000" Value="120" Decimals="0"/>
        <local:Knob x:Name="CompKnee" Caption="拐点" Unit="dB" Minimum="0" Maximum="24" Value="6" Decimals="1"/>
        <local:Knob x:Name="CompMakeup" Caption="补偿" Unit="dB" Minimum="-12" Maximum="24" Value="0" Decimals="1"/>
       </WrapPanel>
      </StackPanel>
      <StackPanel Grid.Column="4">
       <DockPanel Margin="0,0,0,10"><Button Content="恢复矩阵" Tag="matrix" Click="ResetRackClick" DockPanel.Dock="Right" ToolTip="恢复直通矩阵和100%宽度，不切换DSD。"/><TextBlock Text="声道矩阵 / DSD" Style="{StaticResource GroupTitle}" VerticalAlignment="Center"/></DockPanel>
       <WrapPanel ItemWidth="118" ItemHeight="132">
        <local:Knob x:Name="MatLL" Caption="矩阵 LL" Minimum="-2" Maximum="2" Value="1" Decimals="2"/>
        <local:Knob x:Name="MatLR" Caption="矩阵 LR" Minimum="-2" Maximum="2" Value="0" Decimals="2"/>
        <local:Knob x:Name="MatRL" Caption="矩阵 RL" Minimum="-2" Maximum="2" Value="0" Decimals="2"/>
        <local:Knob x:Name="MatRR" Caption="矩阵 RR" Minimum="-2" Maximum="2" Value="1" Decimals="2"/>
        <local:Knob x:Name="WidthBox" Caption="立体声宽度" Minimum="0" Maximum="2" Value="1" Decimals="2"/>
       </WrapPanel>
       <CheckBox x:Name="DcOn" Content="直流滤波（20 Hz 高通）" Margin="0,8,0,8"/>
       <ComboBox x:Name="DsdBox" SelectionChanged="DsdChanged" Width="250" Margin="0,0,0,6"><ComboBoxItem Content="DSD 输出：PCM（原始位深）"/><ComboBoxItem Content="DSD 输出：DSD64 · DoP"/><ComboBoxItem Content="DSD 输出：DSD128 · DoP"/></ComboBox>
       <TextBlock Text="需 DAC 支持 DoP。原生模式下 EQ / 压缩 / 矩阵 / 直流均由系统引擎内核处理；DSD 输出需开启 USB 独占。" Foreground="#C58A4A" FontSize="9" TextWrapping="Wrap" MaxWidth="270"/>
      </StackPanel>
     </Grid>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="3" Style="{StaticResource Card}" Margin="28,0,28,14" Padding="16,4">
   <DockPanel>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
     
     <Border Width="1" Height="20" Background="#E5EAF3" Margin="6,0,12,0"/>
     <Button Content="↶" Click="UndoClick" Background="Transparent" ToolTip="撤销"/><Button Content="A / B" Click="CompareClick" Background="Transparent"/><Button Content="导入" Click="ImportClick" Background="Transparent"/><Button Content="导出" Click="ExportClick" Background="Transparent"/><Button Content="更多" Click="MoreClick" Background="Transparent"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <TextBlock x:Name="Meter" MaxWidth="680" TextTrimming="CharacterEllipsis" Text="尚未开始处理" Foreground="#95A0B4" FontSize="10" VerticalAlignment="Center" Margin="10,0,18,0"/>
     <CheckBox x:Name="AutoStartChk" Content="开机自启" IsChecked="True" Checked="AutoStartChanged" Unchecked="AutoStartChanged" FontSize="10" Margin="0,0,12,0" VerticalAlignment="Center"/><Button Content="麦克风侦听" Click="ListenClick" Margin="0,0,12,0"/><TextBlock Text="bilibili · Fa2517" FontSize="10" Foreground="#8B97AE" VerticalAlignment="Center"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Border x:Name="Splash" Background="#F4F6FA" Panel.ZIndex="10"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border x:Name="SplashAvatar" Width="96" Height="96" CornerRadius="30" Background="#E8ECF5" HorizontalAlignment="Center" ClipToBounds="True"><Image Source="Assets/fa-avatar.jpg" Stretch="UniformToFill"/></Border><TextBlock Text="OpenDSP" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,4"/><TextBlock Text="开源 HiFi DSP 套件" Foreground="#8B97AE" FontSize="13" HorizontalAlignment="Center"/><TextBlock Text="作者 Fa · bilibili Fa2517" Foreground="#586FF4" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0"><Border x:Name="Wave1" Width="4" Height="14" Background="#647AF8" CornerRadius="2" Margin="3"/><Border x:Name="Wave2" Width="4" Height="27" Background="#647AF8" CornerRadius="2" Margin="3"/><Border x:Name="Wave3" Width="4" Height="38" Background="#647AF8" CornerRadius="2" Margin="3"/><Border x:Name="Wave4" Width="4" Height="22" Background="#647AF8" CornerRadius="2" Margin="3"/><Border x:Name="Wave5" Width="4" Height="12" Background="#647AF8" CornerRadius="2" Margin="3"/></StackPanel></StackPanel></Border>
 </Grid>
</Window>
